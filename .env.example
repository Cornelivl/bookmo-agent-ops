# Copy to .env on the Hermes host. Do not commit real secrets.

# Optional, if Hermes/GitHub MCP uses a token instead of local gh auth.
GITHUB_PERSONAL_ACCESS_TOKEN=

# Optional delivery targets configured through `hermes gateway setup`.
SLACK_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=

# Peec uses OAuth against https://api.peec.ai/mcp. Prefer browser auth over API keys.
# Keep this blank unless Peec documents a service token flow for MCP.
PEEC_MCP_TOKEN=

