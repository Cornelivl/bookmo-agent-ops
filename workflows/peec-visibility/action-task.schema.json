{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PeecActionTask",
  "type": "object",
  "required": [
    "source",
    "category",
    "title",
    "recommendation",
    "classification",
    "automationLane",
    "state",
    "risk",
    "effort",
    "evidence"
  ],
  "properties": {
    "source": { "const": "peec" },
    "category": {
      "type": "string",
      "enum": ["owned", "editorial", "reference", "ugc"]
    },
    "slice": { "type": "string" },
    "target": { "type": "string" },
    "title": { "type": "string" },
    "recommendation": { "type": "string" },
    "classification": {
      "type": "string",
      "enum": ["ship", "draft", "review", "manual", "ignore"]
    },
    "automationLane": {
      "type": "string",
      "enum": ["autopilot", "review", "explicit_approval", "blocked"]
    },
    "state": {
      "type": "string",
      "enum": [
        "candidate",
        "reviewed",
        "approved",
        "rejected",
        "drafted",
        "implemented",
        "measuring_7d",
        "measuring_14d",
        "measuring_30d",
        "closed_keep",
        "closed_improve",
        "closed_retry",
        "closed_ignore"
      ],
      "default": "candidate"
    },
    "opportunityScore": { "type": "number" },
    "relativeOpportunity": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "gapPercentage": { "type": "number" },
    "risk": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "effort": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "owner": {
      "type": "string",
      "enum": ["founder", "content", "engineering", "external", "agent"]
    },
    "evidence": {
      "type": "array",
      "items": { "type": "string" }
    },
    "approvalRequired": { "type": "boolean" },
    "publicSafety": {
      "type": "object",
      "properties": {
        "safeForPublicRepo": { "type": "boolean" },
        "redactionsNeeded": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "measurementPlan": {
      "type": "object",
      "properties": {
        "baselineNeeded": { "type": "boolean" },
        "metrics": {
          "type": "array",
          "items": { "type": "string" }
        },
        "checkpoints": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["7d", "14d", "30d"]
          }
        },
        "peecDataWindowNote": { "type": "string" }
      },
      "additionalProperties": false
    },
    "nextStep": { "type": "string" }
  }
}
